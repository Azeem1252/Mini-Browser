import { useState, useEffect, useCallback } from 'react';
import { TabBar, type Tab } from './assets/components/TabBar';
import { AddressBar } from './assets/components/AddressBar';
import { NavigationControls } from './assets/components/NavigationControls';
import { BrowserView } from './assets/components/BrowserView';
import { BookmarksPanel, addBookmark } from './assets/components/BookmarksPanel';
import { HistoryPanel, addToHistory } from './assets/components/HistoryPanel';
import { SettingsPanel } from './assets/components/SettingsPanel';
import { DownloadsPanel } from './assets/components/DownloadsPanel';
import { ParticleBackground } from './assets/components/ParticleBackground';
import { CommandPalette } from './assets/components/CommandPalette';
import { ZoomControls } from './assets/components/ZoomControls';
import { FindInPage } from './assets/components/FindInPage';
import { QRCodeGenerator } from './assets/components/QRCodeGenerator';
import { Confetti } from './assets/components/Confetti';
import { GameHub } from './assets/components/GameHub';
import { StatusBar } from './assets/components/StatusBar';
import { ReadingMode } from './assets/components/ReadingMode';
import { SplitView } from './assets/components/SplitView';
import { PictureInPicture } from './assets/components/PictureInPicture';
import { SpeedDial } from './assets/components/SpeedDial';
import { SessionManager } from './assets/components/SessionManager';
import { apiClient } from './api/client';
import type { BrowserSession } from './types';
import { useElectron } from './hooks/useElectron';
import './App.css';

interface TabState extends Tab {
    content: string;
    isLoading: boolean;
    canGoBack: boolean;
    canGoForward: boolean;
    error?: string;
}

function App() {
    const [tabs, setTabs] = useState<TabState[]>([
        {
            id: 1,
            title: 'New Tab',
            url: 'about:blank',
            content: '',
            isLoading: false,
            canGoBack: false,
            canGoForward: false,
        },
    ]);
    const [activeTabId, setActiveTabId] = useState(1);
    const [nextTabId, setNextTabId] = useState(2);
    const [showBookmarks, setShowBookmarks] = useState(false);
    const [showHistory, setShowHistory] = useState(false);
    const [showSettings, setShowSettings] = useState(false);
    const [showDownloads, setShowDownloads] = useState(false);
    const [showCommandPalette, setShowCommandPalette] = useState(false);
    const [showFindInPage, setShowFindInPage] = useState(false);
    const [zoomLevel, setZoomLevel] = useState(100);
    const [currentTheme, setCurrentTheme] = useState<'dark' | 'light'>('dark');
    const [showQRCode, setShowQRCode] = useState(false);
    const [showConfetti, setShowConfetti] = useState(false);
    const [showGame, setShowGame] = useState(false);
    const [showReadingMode, setShowReadingMode] = useState(false);
    const [showSplitView, setShowSplitView] = useState(false);
    const [showPip, setShowPip] = useState(false);
    const [pipUrl, setPipUrl] = useState('');
    const [showSessionManager, setShowSessionManager] = useState(false);
    const [responseTime, setResponseTime] = useState<number | undefined>();

    // Detect Electron mode and set up API
    const { isElectron } = useElectron();

    // Electron event listeners
    useEffect(() => {
        if (!isElectron || !window.electronAPI) return;

        window.electronAPI.onBrowserViewNavigated(({ tabId, url }) => {
            updateTab(tabId, { url });
        });

        window.electronAPI.onBrowserViewTitleUpdated(({ tabId, title }) => {
            updateTab(tabId, { title });
        });

        window.electronAPI.onBrowserViewLoading(({ tabId, isLoading }) => {
            updateTab(tabId, { isLoading });
        });
    }, [isElectron]);

    // Theme management
    useEffect(() => {
        const savedTheme = localStorage.getItem('browser_theme') || 'dark';
        setCurrentTheme(savedTheme as 'dark' | 'light');
        document.documentElement.setAttribute('data-theme', savedTheme);
    }, []);

    const activeTab = tabs.find((tab) => tab.id === activeTabId);

    const updateTab = useCallback((tabId: number, updates: Partial<TabState>) => {
        setTabs((prevTabs) =>
            prevTabs.map((tab) => (tab.id === tabId ? { ...tab, ...updates } : tab))
        );
    }, []);

    const handleNavigate = useCallback(
        async (url: string, tabId: number = activeTabId) => {
            // Determine if it's a URL or search query
            let targetUrl = url;
            if (!url.includes('://') && !url.startsWith('about:')) {
                if (url.includes('.') && !url.includes(' ')) {
                    targetUrl = `http://${url}`;
                } else {
                    targetUrl = `https://www.google.com/search?q=${encodeURIComponent(url)}`;
                }
            }

            // ELECTRON MODE: Use native BrowserView
            if (isElectron && window.electronAPI) {
                updateTab(tabId, {
                    url: targetUrl,
                    title: targetUrl,
                    isLoading: true,
                    error: undefined
                });

                const result = await window.electronAPI.createBrowserView(tabId, targetUrl, {
                    x: 0,
                    y: 160,  // Position below toolbar + tabs + address bar
                    width: window.innerWidth,
                    height: window.innerHeight - 160,
                });

                if (result.success) {
                    await window.electronAPI.showBrowserView(tabId);
                    addToHistory({ title: targetUrl, url: targetUrl });
                } else {
                    updateTab(tabId, {
                        isLoading: false,
                        error: result.error || 'Failed to create browser view',
                    });
                }
                return;
            }

            // Handle "Live" URLs (http/https) directly in Frontend (Iframe)
            if (targetUrl.startsWith('http://') || targetUrl.startsWith('https://')) {
                updateTab(tabId, {
                    url: targetUrl,
                    title: targetUrl,
                    content: '', // Content handled by iframe
                    isLoading: false,
                    canGoBack: true,
                    error: undefined
                });
                addToHistory({ title: targetUrl, url: targetUrl });
                return;
            }

            // Handle Internal/Mock URLs via Backend
            updateTab(tabId, { isLoading: true, error: undefined });

            const startTime = performance.now();
            const response = await apiClient.navigate(targetUrl, tabId);
            const endTime = performance.now();
            setResponseTime(Math.round(endTime - startTime));

            // Fix: Backend might miss 'success' field in some cases, assume success if content present
            if (response.success || (response.url && response.content)) {
                const title = response.title || new URL(response.url).hostname;
                updateTab(tabId, {
                    url: response.url,
                    title,
                    content: response.content || '',
                    isLoading: false,
                    canGoBack: true,
                });

                // Add to history
                if (!response.url.startsWith('about:')) {
                    addToHistory({ title, url: response.url });
                }
            } else {
                updateTab(tabId, {
                    isLoading: false,
                    error: response.error || 'Failed to load page',
                });
            }
        },
        [activeTabId, updateTab]
    );

    const handleBack = useCallback(async () => {
        if (!activeTab?.canGoBack) return;

        updateTab(activeTabId, { isLoading: true });
        const response = await apiClient.goBack(activeTabId);

        if (response.success) {
            updateTab(activeTabId, {
                url: response.url,
                title: response.title || new URL(response.url).hostname,
                content: response.content || '',
                isLoading: false,
            });
        } else {
            updateTab(activeTabId, { isLoading: false });
        }
    }, [activeTab, activeTabId, updateTab]);

    const handleForward = useCallback(async () => {
        if (!activeTab?.canGoForward) return;

        updateTab(activeTabId, { isLoading: true });
        const response = await apiClient.goForward(activeTabId);

        if (response.success) {
            updateTab(activeTabId, {
                url: response.url,
                title: response.title || new URL(response.url).hostname,
                content: response.content || '',
                isLoading: false,
            });
        } else {
            updateTab(activeTabId, { isLoading: false });
        }
    }, [activeTab, activeTabId, updateTab]);

    const handleRefresh = useCallback(async () => {
        if (!activeTab) return;

        if (!activeTab) return;

        if (isElectron && window.electronAPI) {
            // Use Electron BrowserView API
            await window.electronAPI.browserViewGoForward(activeTabId);
        } else {
            // Web mode: use history API (not implemented for iframes)
            console.log('Go forward not implemented for web mode');
            updateTab(activeTabId, { isLoading: true });
            const response = await apiClient.goForward(activeTabId);

            if (response.success) {
                updateTab(activeTabId, {
                    url: response.url,
                    title: response.title || new URL(response.url).hostname,
                    content: response.content || '',
                    isLoading: false,
                });
            } else {
                updateTab(activeTabId, { isLoading: false });
            }
        }
    }, [activeTab, activeTabId, updateTab, isElectron]);

    const handleRefresh = useCallback(async () => {
        if (!activeTab) return;

        if (isElectron && window.electronAPI) {
            // Use Electron BrowserView API
            await window.electronAPI.browserViewReload(activeTabId);
        } else {
            // Web mode: reload the current URL
            if (activeTab.url !== 'about:blank') {
                handleNavigate(activeTab.url, activeTabId);
            }
        }
    }, [activeTabId, activeTab, isElectron, handleNavigate]);

    const handleZoomIn = useCallback(() => {
        setZoomLevel((prev) => Math.min(prev + 25, 500));
    }, []);

    const handleZoomOut = useCallback(() => {
        setZoomLevel((prev) => Math.max(prev - 25, 25));
    }, []);

    // Session management
    const handleRestoreSession = useCallback((session: BrowserSession) => {
        const firstWindow = session.windows[0];
        if (!firstWindow) return;

        const restoredTabs: TabState[] = firstWindow.tabs.map((tab: any, index: number) => ({
            id: nextTabId + index,
            title: tab.title,
            url: tab.url,
            content: '',
            isLoading: false,
            canGoBack: false,
            canGoForward: false,
        }));

        setTabs(restoredTabs);
        setActiveTabId(restoredTabs[firstWindow.activeTabIndex || 0]?.id || restoredTabs[0].id);
        setNextTabId(nextTabId + restoredTabs.length);
        setShowSessionManager(false);

        // Navigate to each tab's URL
        restoredTabs.forEach((tab) => {
            if (tab.url !== 'about:blank') {
                handleNavigate(tab.url, tab.id);
            }
        });
    }, [nextTabId, handleNavigate]);

    // Picture-in-Picture
    const handleOpenPip = useCallback(() => {
        if (activeTab && activeTab.url !== 'about:blank') {
            setPipUrl(activeTab.url);
            setShowPip(true);
        }
    }, [activeTab]);

    const handleNewTab = useCallback(() => {
        const newTab: TabState = {
            id: nextTabId,
            title: 'New Tab',
            url: 'about:blank',
            content: '',
            isLoading: false,
            canGoBack: false,
            canGoForward: false,
        };
        setTabs((prevTabs) => [...prevTabs, newTab]);
        setActiveTabId(nextTabId);
        setNextTabId(nextTabId + 1);
    }, [nextTabId]);

    // Navigation handlers
    const handleHome = useCallback(() => {
        handleNavigate('about:blank', activeTabId);
    }, [activeTabId, handleNavigate]);

    const handleCloseTab = useCallback(
        (tabId: number) => {
            if (tabs.length === 1) {
                // Don't close the last tab, just reset it
                updateTab(tabId, {
                    title: 'New Tab',
                    url: 'about:blank',
                    content: '',
                    isLoading: false,
                    canGoBack: false,
                    canGoForward: false,
                    error: undefined,
                });
                return;
            }

            setTabs((prevTabs) => {
                const newTabs = prevTabs.filter((tab) => tab.id !== tabId);
                if (activeTabId === tabId) {
                    const closedIndex = prevTabs.findIndex((tab) => tab.id === tabId);
                    const newActiveTab = newTabs[Math.max(0, closedIndex - 1)];
                    setActiveTabId(newActiveTab.id);
                }
                return newTabs;
            });
        },
        [tabs.length, activeTabId, updateTab]
    );

    // Keyboard shortcuts
    useEffect(() => {
        const handleKeyDown = (e: KeyboardEvent) => {
            // Ctrl+T: New tab
            if (e.ctrlKey && e.key === 't') {
                e.preventDefault();
                handleNewTab();
            }
            // Ctrl+W: Close tab
            if (e.ctrlKey && e.key === 'w') {
                e.preventDefault();
                handleCloseTab(activeTabId);
            }
            // Ctrl+D: Bookmark current page
            if (e.ctrlKey && e.key === 'd') {
                e.preventDefault();
                if (activeTab && !activeTab.url.startsWith('about:')) {
                    addBookmark({ title: activeTab.title, url: activeTab.url });
                }
            }
            // Ctrl+H: Show history
            if (e.ctrlKey && e.key === 'h') {
                e.preventDefault();
                setShowHistory(true);
            }
            // Ctrl+R or F5: Refresh
            if ((e.ctrlKey && e.key === 'r') || e.key === 'F5') {
                e.preventDefault();
                handleRefresh();
            }
            // Alt+Left: Back
            if (e.altKey && e.key === 'ArrowLeft') {
                e.preventDefault();
                handleBack();
            }
            // Alt+Right: Forward
            if (e.altKey && e.key === 'ArrowRight') {
                e.preventDefault();
                handleForward();
            }
        };

        window.addEventListener('keydown', handleKeyDown);
        return () => window.removeEventListener('keydown', handleKeyDown);
    }, [activeTabId, handleNewTab, handleCloseTab, handleRefresh, handleBack, handleForward]);

    // Listen for theme changes from settings
    useEffect(() => {
        const handleStorageChange = () => {
            const theme = localStorage.getItem('browser_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', theme);
        };

        window.addEventListener('storage', handleStorageChange);
        // Also listen for custom event for same-tab changes
        window.addEventListener('themeChange', handleStorageChange);

        return () => {
            window.removeEventListener('storage', handleStorageChange);
            window.removeEventListener('themeChange', handleStorageChange);
        };
    }, []);

    // Listen for theme changes to update particle background
    useEffect(() => {
        const handleThemeChange = () => {
            const theme = localStorage.getItem('browser_theme') || 'dark';
            setCurrentTheme(theme as 'dark' | 'light');
        };
        window.addEventListener('themeChange', handleThemeChange);
        return () => window.removeEventListener('themeChange', handleThemeChange);
    }, []);

    // Zoom controls
    const handleZoomIn = () => setZoomLevel((prev) => Math.min(prev + 25, 500));
    const handleZoomOut = () => setZoomLevel((prev) => Math.max(prev - 25, 25));
    const handleZoomReset = () => setZoomLevel(100);

    // Additional keyboard shortcuts
    useEffect(() => {
        const handleKeyDown = (e: KeyboardEvent) => {
            // Ctrl+K: Command palette
            if (e.ctrlKey && e.key === 'k') {
                e.preventDefault();
                setShowCommandPalette(true);
            }
            // Ctrl+F: Find in page
            if (e.ctrlKey && e.key === 'f') {
                e.preventDefault();
                setShowFindInPage(true);
            }
            // Ctrl+Plus: Zoom in
            if (e.ctrlKey && (e.key === '=' || e.key === '+')) {
                e.preventDefault();
                handleZoomIn();
            }
            // Ctrl+Minus: Zoom out
            if (e.ctrlKey && e.key === '-') {
                e.preventDefault();
                handleZoomOut();
            }
            // Ctrl+0: Reset zoom
            if (e.ctrlKey && e.key === '0') {
                e.preventDefault();
                handleZoomReset();
            }
        };
        window.addEventListener('keydown', handleKeyDown);
        return () => window.removeEventListener('keydown', handleKeyDown);
    }, []);

    return (
        <div className="app">
            <ParticleBackground theme={currentTheme} />
            <TabBar
                tabs={tabs}
                activeTabId={activeTabId}
                onTabSelect={setActiveTabId}
                onTabClose={handleCloseTab}
                onNewTab={handleNewTab}
            />

            <div className="browser-chrome">
                <NavigationControls
                    canGoBack={activeTab?.canGoBack || false}
                    canGoForward={activeTab?.canGoForward || false}
                    isLoading={activeTab?.isLoading || false}
                    onBack={handleBack}
                    onForward={handleForward}
                    onRefresh={handleRefresh}
                    onHome={handleHome}
                />

                <AddressBar
                    url={activeTab?.url || ''}
                    isLoading={activeTab?.isLoading || false}
                    isSecure={activeTab?.url?.startsWith('https://') || false}
                    onNavigate={(url) => handleNavigate(url, activeTabId)}
                />

                <div className="browser-actions">
                    <button className="action-button" title="Bookmarks (Ctrl+D)" onClick={() => setShowBookmarks(true)}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" />
                        </svg>
                    </button>
                    <button className="action-button" title="History (Ctrl+H)" onClick={() => setShowHistory(true)}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <circle cx="12" cy="12" r="10" strokeWidth="2" />
                            <path d="M12 6v6l4 2" strokeWidth="2" strokeLinecap="round" />
                        </svg>
                    </button>
                    <button className="action-button" title="Downloads" onClick={() => setShowDownloads(true)}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" />
                        </svg>
                    </button>
                    <button className="action-button" title="QR Code" onClick={() => setShowQRCode(true)}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <rect x="3" y="3" width="7" height="7" strokeWidth="2" />
                            <rect x="14" y="3" width="7" height="7" strokeWidth="2" />
                            <rect x="3" y="14" width="7" height="7" strokeWidth="2" />
                            <rect x="14" y="14" width="7" height="7" strokeWidth="2" />
                        </svg>
                    </button>
                    <button className="action-button" title="Play Game" onClick={() => setShowGame(true)}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <rect x="2" y="7" width="20" height="10" rx="2" strokeWidth="2" />
                            <circle cx="7" cy="12" r="1" fill="currentColor" />
                            <circle cx="17" cy="10" r="1" fill="currentColor" />
                            <circle cx="17" cy="14" r="1" fill="currentColor" />
                        </svg>
                    </button>
                    <button className="action-button" title="Settings" onClick={() => setShowSettings(true)}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <circle cx="12" cy="12" r="3" strokeWidth="2" />
                            <path d="M12 1v6m0 6v6M5.64 5.64l4.24 4.24m4.24 4.24l4.24 4.24M1 12h6m6 0h6M5.64 18.36l4.24-4.24m4.24-4.24l4.24-4.24" strokeWidth="2" strokeLinecap="round" />
                        </svg>
                    </button>
                    <button className="action-button" title="Reading Mode" onClick={() => setShowReadingMode(true)} disabled={!activeTab?.content}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" />
                            <path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" />
                        </svg>
                    </button>
                    <button className="action-button" title="Split View" onClick={() => setShowSplitView(!showSplitView)}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <rect x="3" y="3" width="18" height="18" rx="2" strokeWidth="2" />
                            <line x1="12" y1="3" x2="12" y2="21" strokeWidth="2" />
                        </svg>
                    </button>
                    <button className="action-button" title="Picture in Picture" onClick={handleOpenPip} disabled={activeTab?.url === 'about:blank'}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <rect x="2" y="4" width="20" height="14" rx="2" strokeWidth="2" />
                            <rect x="12" y="10" width="8" height="6" rx="1" strokeWidth="2" fill="var(--bg-tertiary)" />
                        </svg>
                    </button>
                    <button className="action-button" title="Sessions" onClick={() => setShowSessionManager(true)}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M17 3a2.83 2.83 0 114 4L7.5 20.5 2 22l1.5-5.5L17 3z" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" />
                        </svg>
                    </button>
                </div>

                <ZoomControls
                    zoomLevel={zoomLevel}
                    onZoomIn={handleZoomIn}
                    onZoomOut={handleZoomOut}
                    onZoomReset={handleZoomReset}
                />
            </div>

            {activeTab?.isLoading && (
                <div className="loading-progress">
                    <div className="loading-progress-bar indeterminate" />
                </div>
            )}

            <FindInPage
                isOpen={showFindInPage}
                onClose={() => setShowFindInPage(false)}
                content={activeTab?.content || ''}
            />

            {showSplitView ? (
                <SplitView
                    isOpen={showSplitView}
                    primaryUrl={activeTab?.url || 'about:blank'}
                    primaryContent={
                        activeTab?.url === 'about:blank' ? (
                            <SpeedDial onNavigate={(url) => handleNavigate(url, activeTabId)} />
                        ) : (
                            <div style={{ transform: `scale(${zoomLevel / 100})`, transformOrigin: 'top left', width: `${100 / (zoomLevel / 100)}%`, height: `${100 / (zoomLevel / 100)}%` }}>
                                <BrowserView
                                    url={activeTab?.url || ''}
                                    content={activeTab?.content || ''}
                                    isLoading={activeTab?.isLoading || false}
                                    error={activeTab?.error}
                                    tabId={activeTabId}
                                    isElectron={isElectron ? true : false}
                                />
                            </div>
                        )
                    }
                    onClose={() => setShowSplitView(false)}
                    onNavigate={(url) => handleNavigate(url, activeTabId)}
                />
            ) : (
                activeTab?.url === 'about:blank' ? (
                    <SpeedDial onNavigate={(url) => handleNavigate(url, activeTabId)} />
                ) : (
                    <div style={{ transform: `scale(${zoomLevel / 100})`, transformOrigin: 'top left', width: `${100 / (zoomLevel / 100)}%`, height: `${100 / (zoomLevel / 100)}%` }}>
                        <BrowserView
                            url={activeTab?.url || ''}
                            content={activeTab?.content || ''}
                            isLoading={activeTab?.isLoading || false}
                            error={activeTab?.error}
                            tabId={activeTabId}
                            isElectron={isElectron ? true : false}
                        />
                    </div>
                )
            )}

            <BookmarksPanel
                isOpen={showBookmarks}
                onClose={() => setShowBookmarks(false)}
                onNavigate={handleNavigate}
            />

            <HistoryPanel
                isOpen={showHistory}
                onClose={() => setShowHistory(false)}
                onNavigate={handleNavigate}
            />

            <SettingsPanel
                isOpen={showSettings}
                onClose={() => setShowSettings(false)}
            />

            <DownloadsPanel
                isOpen={showDownloads}
                onClose={() => setShowDownloads(false)}
            />

            <CommandPalette
                isOpen={showCommandPalette}
                onClose={() => setShowCommandPalette(false)}
                tabs={tabs}
                onNavigateToTab={setActiveTabId}
                onNewTab={handleNewTab}
                onOpenBookmarks={() => { setShowBookmarks(true); setShowCommandPalette(false); }}
                onOpenHistory={() => { setShowHistory(true); setShowCommandPalette(false); }}
                onOpenSettings={() => { setShowSettings(true); setShowCommandPalette(false); }}
            />

            <QRCodeGenerator
                isOpen={showQRCode}
                onClose={() => setShowQRCode(false)}
                url={activeTab?.url || 'about:blank'}
            />

            <Confetti
                isActive={showConfetti}
                onComplete={() => setShowConfetti(false)}
            />

            <GameHub
                isOpen={showGame}
                onClose={() => setShowGame(false)}
            />

            <ReadingMode
                isOpen={showReadingMode}
                onClose={() => setShowReadingMode(false)}
                content={activeTab?.content || ''}
                title={activeTab?.title || ''}
                url={activeTab?.url || ''}
            />

            {showPip && (
                <PictureInPicture
                    isOpen={showPip}
                    url={pipUrl}
                    title={activeTab?.title || 'Mini Browser'}
                    content={
                        <BrowserView
                            url={pipUrl}
                            content={activeTab?.content || ''}
                            isLoading={false}
                            tabId={activeTabId}
                            isElectron={false}
                        />
                    }
                    onClose={() => setShowPip(false)}
                    onNavigate={(url) => setPipUrl(url)}
                />
            )}

            <SessionManager
                isOpen={showSessionManager}
                onClose={() => setShowSessionManager(false)}
                currentTabs={tabs.map(t => ({ title: t.title, url: t.url, isPinned: false }))}
                onRestoreSession={handleRestoreSession}
            />

            <StatusBar
                url={activeTab?.url || ''}
                isLoading={activeTab?.isLoading || false}
                isSecure={activeTab?.url?.startsWith('https://') || false}
                zoomLevel={zoomLevel}
                connectionInfo={responseTime ? { protocol: 'https', responseTime } : undefined}
            />
        </div>
    );
}

export default App;
